# Stellar Sentinel — Environment Variables
# Copy this file to .env and fill in your values.

# ─── Required ─────────────────────────────────────────────────────────────────
# Stellar Horizon endpoint (testnet or mainnet)
HORIZON_URL=https://horizon-testnet.stellar.org

# Comma-separated list of Stellar public keys to monitor
TRACKED_ADDRESSES=GABC...1,GABC...2

# ─── Notification Channels (at least one required) ────────────────────────────
# HTTP webhook: receives signed JSON POST for each matched payment
# WEBHOOK_URL=https://my-app.com/api/stellar-events
# WEBHOOK_SECRET=my-hmac-secret-key

# Discord channel webhook URL
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Telegram bot token + chat ID
# TELEGRAM_BOT_TOKEN=123456:ABC-...
# TELEGRAM_CHAT_ID=-1001234567890

# ─── Optional Filtering ───────────────────────────────────────────────────────
# Comma-separated asset codes to filter (e.g. XLM,USDC). Empty = all assets.
# FILTER_ASSETS=USDC,EURC

# Minimum amount to trigger a notification (in asset units). Default: 0
# MIN_AMOUNT=10

# ─── Optional Tuning ─────────────────────────────────────────────────────────
# HTTP server port for health check and metrics endpoints. Default: 8080
# PORT=8080

# Reconnect backoff max in seconds. Default: 60
# MAX_BACKOFF_SECS=60
